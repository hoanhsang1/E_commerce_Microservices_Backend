# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_1234567890

# Internal Service-to-Service Security Key
INTERNAL_API_KEY=your_internal_api_secret_key_here

# Notification Mail Service (Google App Password)
MAIL_APP_PASSWORD="your_google_app_password_here"
